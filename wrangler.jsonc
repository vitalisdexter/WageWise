{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wagewise",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-22",
  "build": { "command": "npm test && npm run build" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/reminders/*", "/api/account/*", "/api/admin/*", "/admin", "/admin/"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "REMINDERS",
      "database_name": "wagewise-reminders",
      "database_id": "dcc280cc-5809-4a6b-a052-c9cb69865954"
    }
  ],
  "vars": {
    "VAPID_PUBLIC_KEY": "BGSPjPwzE2XC2ckf6BfMGDO0HOAFt91Iu950XTv0IDqKjMsokVYJC2v_kpp9bUkgIBAn92cuy_5zbVcbNjQRRuQ"
  },
  "triggers": {"crons": ["*/5 * * * *"]}
}
